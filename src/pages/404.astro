---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="es"
  title="404 | PÁGINA NO ENCONTRADA"
  description="La página que buscas no existe en esta edición del periódico."
>
  <main class="py-16 md:py-24 text-center border-b-4 border-black">
    <p id="not-found-kicker" class="font-label-mono text-label-mono uppercase mb-4">
      Extra - Edición especial
    </p>
    <h1 class="font-display-xl text-5xl md:text-7xl uppercase tracking-tighter mb-6">404</h1>
    <p id="not-found-headline" class="font-headline-md text-2xl uppercase mb-4">Página no encontrada</p>
    <p id="not-found-message" class="font-body-md text-secondary max-w-md mx-auto mb-10">
      La historia que buscas no aparece en esta edición. Puede que el enlace esté roto o la página haya sido retirada de circulación.
    </p>
    <div class="flex justify-center">
      <a
        id="not-found-home"
        class="font-label-mono text-label-mono border border-black px-6 py-3 uppercase font-bold hover:bg-black hover:text-white transition-all"
        href="/"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    var path = window.location.pathname;
    var isEn = path.indexOf('/en') === 0 || localStorage.getItem('preferred-lang') === 'en';
    if (!isEn) return;

    var kicker = document.getElementById('not-found-kicker');
    var headline = document.getElementById('not-found-headline');
    var message = document.getElementById('not-found-message');
    var home = document.getElementById('not-found-home');

    document.documentElement.lang = 'en';
    document.title = '404 | PAGE NOT FOUND';

    if (kicker) kicker.textContent = 'Extra - Special edition';
    if (headline) headline.textContent = 'PAGE NOT FOUND';
    if (message) {
      message.textContent =
        'The story you are looking for is not in this edition. The link may be broken or the page may have been taken out of circulation.';
    }
    if (home) {
      home.href = '/en/';
      home.textContent = 'BACK TO HOME';
    }
  })();
</script>
