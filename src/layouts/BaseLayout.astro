---
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getPersonStructuredData, personal, type Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  keywords?: string;
}

const { lang, title, description, keywords } = Astro.props;

const siteBase = Astro.site ?? Astro.url;

function getLocaleAbsoluteUrl(locale: Lang): string {
  const path = getRelativeLocaleUrl(locale);
  return new URL(path, siteBase).href;
}

const esUrl = getLocaleAbsoluteUrl('es');
const enUrl = getLocaleAbsoluteUrl('en');
const canonicalUrl = lang === 'en' ? enUrl : esUrl;
const ogImage = new URL('/og-image.png', siteBase).href;
const ogImageAlt =
  lang === 'es'
    ? 'Aarón Méndez - Ingeniero Informático y Desarrollador Web'
    : 'Aarón Méndez - Computer Engineer & Web Developer';

const personSchema = getPersonStructuredData(lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: personSchema.name,
  jobTitle: personSchema.jobTitle,
  alumniOf: personSchema.alumniOf,
  knowsAbout: personSchema.knowsAbout,
  url: canonicalUrl,
  email: personal.email,
  sameAs: [personal.github, personal.linkedin],
};
---

<html class="light" lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="google-site-verification" content="Qs_mK84EuF4qQ5jpYhfTlWSWzGucJejz5ROCPqTx7Hc" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Aarón M" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta name="theme-color" content="#eae6dc" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aaronmendez" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500&family=Courier+Prime&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body.site-vintage-newsprint {
        background-color: #eae6dc;
        min-height: 100vh;
      }

      body.site-vintage-newsprint::after {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 999;
        background: radial-gradient(ellipse at center, transparent 30%, rgba(130, 105, 70, 0.35) 100%);
      }
    </style>
  </head>
  <body class="site-vintage-newsprint font-body-md text-on-surface text-base max-w-full overflow-x-clip bg-background min-h-screen">
    <a
      href="#hero"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-black focus:text-white focus:px-4 focus:py-2 focus:font-label-mono focus:text-xs focus:uppercase"
    >
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <div class="max-w-7xl mx-auto w-full min-w-0 min-h-screen px-4 sm:px-6 lg:px-8 bg-background">
      <slot />
    </div>
  </body>
</html>
