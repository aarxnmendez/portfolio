---
import { getContent, type Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const editorial = getContent(lang).editorial;
const extra = getContent(lang).extra;
---

<section id="editorial" class="section-block">
  <h2 class="section-title section-heading">
    {editorial.sectionTitle}
  </h2>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 border border-black lg:items-stretch">
    <div class="p-6 sm:p-8 lg:border-r border-black lg:v-rule flex flex-col min-h-full">
      <h3 class="section-subtitle section-subtitle-rule">{editorial.title}</h3>
      <div class="space-y-4 flex-1">
        {
          editorial.paragraphs.map((paragraph, index) => (
            <p
              class:list={[
                'font-body-md text-secondary leading-relaxed text-pretty',
                index === 0 && 'drop-cap text-on-surface',
              ]}
            >
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>

    <div class="p-6 sm:p-8 border-t lg:border-t-0 border-black flex flex-col min-h-full">
      <h3 class="section-subtitle section-subtitle-rule">{extra.title}</h3>
      <div class="flex flex-col flex-1 h-full justify-between min-h-0">
        {
          extra.items.map((item, index) => (
            <div
              class:list={[
                'flex flex-1 gap-4 min-h-0',
                index === 0 && 'pb-6',
                index < extra.items.length - 1 && 'border-b border-black/40',
                index === extra.items.length - 1 && 'pt-6',
              ]}
            >
              <span class="font-headline-lg text-4xl text-black/10 shrink-0">{item.number}</span>
              <div class="flex flex-col justify-center items-start">
                <span
                  class:list={[
                    'font-label-mono text-[10px] px-2 py-0.5 uppercase mb-2 inline-block w-fit self-start',
                    item.badgeStyle === 'filled' ? 'bg-black text-white' : 'border border-black',
                  ]}
                >
                  {item.badge}
                </span>
                <h4 class="font-headline-md text-lg sm:text-xl leading-tight mb-1 uppercase">{item.title}</h4>
                <p class="font-caption text-secondary text-pretty">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
