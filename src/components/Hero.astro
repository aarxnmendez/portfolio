---
import { getContent, personal, type Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).hero;
---

<section
  id="hero"
  class="grid grid-cols-1 md:grid-cols-[minmax(0,3fr)_minmax(0,7fr)] gap-4 md:gap-6 pb-10 md:pb-12 border-b-4 border-black w-full min-w-0 items-center"
>
  <div class="flex flex-col justify-center min-w-0 w-full md:max-w-[280px] lg:max-w-[320px] mx-auto md:mx-0">
    <div class="halftone-container halftone-container--subtle border border-black w-full aspect-square bg-background">
      <img
        alt={t.imageAlt}
        class="halftone-photo halftone-photo--subtle w-full h-full object-cover object-center"
        src={t.imageUrl}
        width="480"
        height="480"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div
    class="flex flex-col justify-center min-w-0 md:border-l md:border-black md:pl-6 lg:pl-8 pt-5 md:pt-0 border-t md:border-t-0 border-black"
  >
    <h2 class="hero-headline uppercase leading-[1.02] tracking-tight mb-4 text-balance">
      {t.headline}
    </h2>

    <p class="font-body-lg text-secondary leading-relaxed text-pretty border-t border-black pt-4 italic">
      {t.lead}
    </p>

    <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-6">
      <div class="flex items-center gap-3 font-label-mono text-[11px] uppercase text-secondary">
        <a class="hover:text-primary hover:underline transition-colors" href={personal.github} target="_blank" rel="noopener noreferrer" aria-label={t.cta.githubAriaLabel}>{t.cta.github}</a>
        <span class="text-black/30" aria-hidden="true">|</span>
        <a class="hover:text-primary hover:underline transition-colors" href={personal.linkedin} target="_blank" rel="noopener noreferrer" aria-label={t.cta.linkedinAriaLabel}>{t.cta.linkedin}</a>
      </div>
    </div>
  </div>
</section>
