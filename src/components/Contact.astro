---
import { getContent, type Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).contact;
---

<section
  id="contact"
  class="contact-section flex flex-col items-center text-center py-12 sm:py-16"
>
  <a
    class="font-headline-md text-3xl sm:text-5xl md:text-6xl tracking-tight leading-none block hover:underline break-all"
    href={`mailto:${t.email}`}
    aria-label={t.emailAriaLabel}
  >
    {t.email}
  </a>
  <button
    type="button"
    id="copy-email-btn"
    class="mt-8 px-8 py-3 border border-black font-label-mono text-[12px] uppercase font-bold hover:bg-black hover:text-white transition-all"
    data-email={t.email}
    data-success={t.copySuccess}
    aria-label={t.copyEmailAriaLabel}
  >
    {t.copyButton}
  </button>
</section>

<script>
  const btn = document.getElementById('copy-email-btn');
  if (btn instanceof HTMLButtonElement) {
    const email = btn.dataset.email ?? '';
    const successLabel = btn.dataset.success ?? 'OK';
    const defaultLabel = btn.textContent ?? '';

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        btn.textContent = successLabel;
        window.setTimeout(() => {
          btn.textContent = defaultLabel;
        }, 2000);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
