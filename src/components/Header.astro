---
import { getContent, type Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).header;
---

<header class="w-full bg-background pt-4 sm:pt-6 md:pt-8">
  <div class="w-full min-w-0">
    <div class="flex justify-between items-center gap-3 border-b border-black pb-1 mb-1 font-label-mono text-[10px] uppercase min-w-0">
      <span class="shrink-0">{t.vol}</span>
      <div class="hidden md:flex gap-2 items-center shrink-0">
        <span>{t.est}</span>
        <span class="text-black/40">|</span>
        <a
          class:list={['hover:underline shrink-0', lang === 'en' && 'font-bold']}
          href="/en"
          onclick="localStorage.removeItem('portfolio-lang'); localStorage.setItem('preferred-lang', 'en')"
        >
          [ EN ]
        </a>
        <span class="text-black/40">|</span>
        <a
          class:list={['hover:underline shrink-0', lang === 'es' && 'font-bold']}
          href="/"
          onclick="localStorage.removeItem('portfolio-lang'); localStorage.setItem('preferred-lang', 'es')"
        >
          [ ES ]
        </a>
      </div>
      <div class="flex md:hidden gap-2 items-center shrink-0">
        <a
          class:list={['hover:underline shrink-0', lang === 'en' && 'font-bold']}
          href="/en"
          onclick="localStorage.removeItem('portfolio-lang'); localStorage.setItem('preferred-lang', 'en')"
        >
          [ EN ]
        </a>
        <span class="text-black/40">|</span>
        <a
          class:list={['hover:underline shrink-0', lang === 'es' && 'font-bold']}
          href="/"
          onclick="localStorage.removeItem('portfolio-lang'); localStorage.setItem('preferred-lang', 'es')"
        >
          [ ES ]
        </a>
      </div>
      <div class="hidden md:block shrink-0 text-right">{t.price}</div>
    </div>

    <div class="py-4 sm:py-5 md:py-6 border-b-4 border-black">
      <div class="hidden md:grid md:grid-cols-3 md:gap-x-gutter md:items-center">
        <div class="flex flex-col items-start leading-tight">
          <span class="font-label-mono text-label-mono uppercase">{t.date}</span>
          <span class="font-label-mono text-label-mono uppercase">{t.edition}</span>
        </div>
        <div class="flex flex-col items-center text-center min-w-0 px-2">
          <h1
            class="font-headline-lg font-black text-primary tracking-tighter uppercase leading-none whitespace-nowrap text-3xl sm:text-4xl md:text-5xl lg:text-6xl"
          >
            {t.name}
          </h1>
        </div>
        <div class="flex flex-col items-end leading-tight text-right">
          <span class="font-label-mono text-label-mono uppercase">{t.location}</span>
        </div>
      </div>

      <div class="md:hidden flex flex-col items-center text-center gap-2 sm:gap-3 min-w-0 w-full">
        <p class="font-label-mono text-xs uppercase leading-snug text-center">
          <span>{t.date}</span>
          <span class="mx-1 text-black/40">/</span>
          <span>{t.edition}</span>
        </p>
        <h1
          class="font-headline-lg font-black text-primary tracking-tighter uppercase leading-none whitespace-nowrap text-2xl sm:text-3xl max-w-full"
        >
          {t.name}
        </h1>
        <p class="font-label-mono text-xs uppercase leading-snug">{t.location}</p>
      </div>
    </div>
  </div>
</header>

<nav
  class="site-nav sticky top-0 z-[60] bg-background py-2 border-b-4 border-black border-double w-full min-w-0"
  aria-label={t.navAriaLabel}
>
  <div class="w-full min-w-0 -mx-1 px-1 overflow-x-auto no-scrollbar md:overflow-visible">
    <div class="flex gap-4 md:gap-gutter items-center whitespace-nowrap md:flex-wrap">
      {
        t.nav.map((item) => (
          <a
            class="site-nav__link shrink-0"
            href={item.href}
            data-nav-link
            data-section={item.href.replace('#', '')}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const sectionIds = ['works', 'classifieds', 'timelines', 'editorial', 'contact'];
  const contactSectionId = 'contact';
  const mobileNavQuery = '(max-width: 767px)';

  let isClickScrolling = false;
  let clickScrollSafetyTimer: ReturnType<typeof setTimeout> | undefined;
  let clickScrollTargetId: string | null = null;
  let scrollSpyInitialized = false;
  let scrollSpyObserver: IntersectionObserver | null = null;

  function isMobileViewport(): boolean {
    return window.matchMedia(mobileNavQuery).matches;
  }

  function getNavHeight(): number {
    const nav = document.querySelector('.site-nav');
    return nav?.getBoundingClientRect().height ?? 48;
  }

  function getScrollMarginExtra(): number {
    return isMobileViewport() ? 32 : 20;
  }

  function updateNavMetrics(): void {
    const navHeight = getNavHeight();
    const scrollOffset = navHeight + getScrollMarginExtra();
    document.documentElement.style.setProperty('--site-nav-height', `${navHeight}px`);
    document.documentElement.style.setProperty('--site-scroll-offset', `${scrollOffset}px`);
  }

  function getNavOffset(): number {
    return getNavHeight() + getScrollMarginExtra();
  }

  function getObserverRootMargin(): string {
    const topInset = getNavOffset();
    const bottomInset = isMobileViewport() ? '45%' : '55%';
    return `-${topInset}px 0px -${bottomInset} 0px`;
  }

  function getObserverThreshold(): number[] {
    return isMobileViewport() ? [0, 0.2, 0.45, 0.7] : [0, 0.15, 0.35, 0.55, 0.75, 1];
  }

  function isAtPageBottom(): boolean {
    return window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 10;
  }

  function setActiveSection(id: string): void {
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const isActive = link.dataset.section === id;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function waitForScrollEnd(onComplete: () => void): void {
    const fallbackMs = isMobileViewport() ? 2200 : 1400;
    let completed = false;

    const finish = () => {
      if (completed) return;
      completed = true;
      if (poll !== undefined) window.clearInterval(poll);
      window.clearTimeout(fallbackTimer);
      onComplete();
    };

    let poll: ReturnType<typeof setInterval> | undefined;
    let fallbackTimer: ReturnType<typeof setTimeout>;

    if ('onscrollend' in window) {
      const handleScrollEnd = () => {
        window.removeEventListener('scrollend', handleScrollEnd);
        window.requestAnimationFrame(() => window.requestAnimationFrame(finish));
      };
      window.addEventListener('scrollend', handleScrollEnd, { once: true });
    } else {
      let lastScrollY = window.scrollY;
      let stableFrames = 0;
      const stableFramesRequired = isMobileViewport() ? 6 : 3;

      poll = window.setInterval(() => {
        if (window.scrollY === lastScrollY) {
          stableFrames += 1;
          if (stableFrames >= stableFramesRequired) {
            finish();
          }
          return;
        }

        stableFrames = 0;
        lastScrollY = window.scrollY;
      }, 50);
    }

    fallbackTimer = window.setTimeout(finish, fallbackMs);
  }

  function sectionAlignsWithNav(sectionId: string): boolean {
    const section = document.getElementById(sectionId);
    if (!section) return false;

    const offset = getNavOffset();
    const top = section.getBoundingClientRect().top;
    return Math.abs(top - offset) <= (isMobileViewport() ? 72 : 48);
  }

  function initNavScrollSpy(): void {
    if (scrollSpyInitialized) return;

    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section !== null);

    if (sections.length === 0) return;

    scrollSpyInitialized = true;
    updateNavMetrics();

    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

    const updateActiveFromScroll = (): void => {
      if (isClickScrolling) return;

      if (isAtPageBottom()) {
        setActiveSection(contactSectionId);
        return;
      }

      const offset = getNavOffset();
      let currentId = sectionIds[0];

      for (const section of sections) {
        if (section.getBoundingClientRect().top <= offset) {
          currentId = section.id;
        }
      }

      setActiveSection(currentId);
    };

    const finishClickScroll = (targetSectionId: string): void => {
      isClickScrolling = false;
      clickScrollTargetId = null;

      if (isAtPageBottom()) {
        setActiveSection(contactSectionId);
        return;
      }

      if (sectionAlignsWithNav(targetSectionId)) {
        setActiveSection(targetSectionId);
        return;
      }

      updateActiveFromScroll();
    };

    const connectScrollSpyObserver = (): void => {
      scrollSpyObserver?.disconnect();

      scrollSpyObserver = new IntersectionObserver(
        (entries) => {
          if (isClickScrolling) return;

          if (isAtPageBottom()) {
            setActiveSection(contactSectionId);
            return;
          }

          if (isMobileViewport()) {
            updateActiveFromScroll();
            return;
          }

          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

          if (visible.length > 0) {
            setActiveSection(visible[0].target.id);
            return;
          }

          updateActiveFromScroll();
        },
        {
          rootMargin: getObserverRootMargin(),
          threshold: getObserverThreshold(),
        },
      );

      sections.forEach((section) => scrollSpyObserver?.observe(section));
    };

    connectScrollSpyObserver();

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const sectionId = link.dataset.section;
        if (!sectionId) return;

        isClickScrolling = true;
        clickScrollTargetId = sectionId;
        setActiveSection(sectionId);

        if (clickScrollSafetyTimer) window.clearTimeout(clickScrollSafetyTimer);

        const completeClickScroll = () => {
          if (!isClickScrolling || clickScrollTargetId !== sectionId) return;
          if (clickScrollSafetyTimer) window.clearTimeout(clickScrollSafetyTimer);
          finishClickScroll(sectionId);
        };

        waitForScrollEnd(completeClickScroll);

        const safetyMs = isMobileViewport() ? 2800 : 1800;
        clickScrollSafetyTimer = window.setTimeout(completeClickScroll, safetyMs);
      });
    });

    const hash = window.location.hash.replace('#', '');
    if (hash && sectionIds.includes(hash)) {
      setActiveSection(hash);
    } else {
      updateActiveFromScroll();
    }

    window.addEventListener('scroll', updateActiveFromScroll, { passive: true });
    window.addEventListener('resize', () => {
      updateNavMetrics();
      connectScrollSpyObserver();
      updateActiveFromScroll();
    });
  }

  initNavScrollSpy();
  document.addEventListener('astro:page-load', () => {
    scrollSpyObserver?.disconnect();
    scrollSpyObserver = null;
    scrollSpyInitialized = false;
    initNavScrollSpy();
  });
</script>
