---
import type { TimelineEntry } from '../data/portfolioData';

interface Props {
  entry: TimelineEntry;
}

const { entry } = Astro.props;
---

<div class="relative pl-12">
  <div
    class="absolute left-0 top-1.5 w-8 h-8 bg-background border-2 border-black flex items-center justify-center"
    aria-hidden="true"
  >
    <div class="w-2 h-2 bg-black rotate-45"></div>
  </div>
  <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-2">
    <span class="font-label-mono text-[11px] font-black uppercase tracking-tighter">{entry.period}</span>
    <span
      class:list={[
        'px-2 py-0.5 font-label-mono text-[9px] uppercase tracking-widest w-fit',
        entry.tagStyle === 'filled' ? 'bg-black text-white' : 'border border-black',
      ]}
    >
      {entry.tag}
    </span>
  </div>
  <h4 class="font-headline-md text-lg sm:text-xl leading-tight mb-1">{entry.title}</h4>
  {entry.company && <p class="font-label-mono text-[11px] uppercase text-secondary mb-2">{entry.company}</p>}
  {
    entry.highlights && entry.highlights.length > 0 ? (
      <ul class="font-body-md text-secondary leading-relaxed text-pretty space-y-1.5 list-none">
        {entry.highlights.map((point) => (
          <li class="flex gap-2">
            <span class="font-label-mono text-[10px] shrink-0 mt-0.5">-</span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    ) : (
      entry.description && <p class="font-body-md text-secondary leading-relaxed text-pretty">{entry.description}</p>
    )
  }
</div>
