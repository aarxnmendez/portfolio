---
import type { TimelineEntry } from '../data/portfolioData';

interface Props {
  entry: TimelineEntry;
}

const { entry } = Astro.props;
const isCurrent = /presente|present/i.test(entry.period);
---

<div class="timeline-item relative pl-12">
  <div
    class="timeline-item__node absolute left-0 top-1.5 w-8 h-8 bg-background border-2 border-black flex items-center justify-center"
    aria-hidden="true"
  >
    {isCurrent && <div class="w-2 h-2 bg-black rotate-45"></div>}
  </div>
  <div class="mb-2">
    <span class="font-label-mono text-[11px] font-black uppercase tracking-tighter">{entry.period}</span>
  </div>
  <h4 class="font-headline-md text-lg sm:text-xl leading-tight mb-1">{entry.title}</h4>
  {
    entry.company && (
      <p class="font-label-mono text-[11px] uppercase text-secondary mb-2">
        {entry.url ? (
          <a
            class="timeline-company-link text-secondary hover:text-primary hover:underline transition-colors"
            href={entry.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {entry.company}
          </a>
        ) : (
          entry.company
        )}
      </p>
    )
  }
  {entry.description && (
    <p class="font-body-md text-secondary leading-relaxed text-pretty">{entry.description}</p>
  )}
</div>
