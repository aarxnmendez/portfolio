---
import { getContent, type Lang } from '../data/portfolioData';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).works;
---

<section id="works" class="section-block section-block--first">
  <h2 class="section-title section-heading">{t.title}</h2>

  <div class="flex flex-col gap-6">
    {
      t.projects.map((project) => (
        <article class="lead-story group w-full border border-black grid grid-cols-1 md:grid-cols-2">
          <div class="lead-story__media border-b md:border-b-0 md:border-r border-black bg-black/[0.03] p-4 sm:p-6">
            <div class="lead-story__frame relative aspect-video w-full overflow-hidden border border-black/50 bg-background">
              {
                project.imageUrl ? (
                  <img
                    alt={project.imageAlt ?? project.title}
                    class="lead-story__image w-full h-full object-cover border border-black/20"
                    src={project.imageUrl}
                    loading="lazy"
                    decoding="async"
                    width="1280"
                    height="720"
                  />
                ) : (
                  <div class="project-preview__media w-full h-full flex items-center justify-center p-6 text-center">
                    <span class="font-headline-md text-2xl md:text-3xl uppercase leading-tight opacity-40 tracking-[0.12em]">
                      {project.title}
                    </span>
                  </div>
                )
              }
            </div>
          </div>

          <div class="lead-story__content flex flex-col p-5 sm:p-6 md:p-8">
            <span class="font-label-mono text-[10px] uppercase mb-4">{project.number}</span>
            <h3 class="font-headline-md text-2xl sm:text-3xl leading-tight mb-4 group-hover:underline">
              {project.title}
            </h3>
            <p class="font-body-md text-secondary leading-relaxed text-pretty mb-6 flex-1">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6">
              {project.tags.map((tag) => (
                <span class="px-1.5 py-0.5 border border-black font-label-mono text-[9px] uppercase">{tag}</span>
              ))}
            </div>

            <div class="flex flex-col sm:flex-row gap-2 border-t border-black pt-4 mt-auto">
              {
                project.githubUrl && (
                  <a
                    class="btn-vintage btn-vintage--sm flex-1 text-center"
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t.codeGithub}
                  </a>
                )
              }
              {
                project.demoUrl && (
                  <a
                    class="btn-vintage btn-vintage--sm flex-1 text-center"
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t.viewDemo}
                  </a>
                )
              }
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
